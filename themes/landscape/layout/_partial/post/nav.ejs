<% if (post.prev || post.next){ %>
<nav id="article-nav flex" class="article-nav flex flex-row justify-between items-center px-4">
  <% if (post.prev){ %>
    <a href="<%- url_for(post.prev.path) %>" id="article-nav-older" class="article-nav-link-wrap w-full md:w-auto text-nowrap text-left">
      <strong class="article-nav-caption"><%= __('older') %></strong>
      <div class="article-nav-title">
        <% if (post.prev.title){ %>
          <%= post.prev.title %>
        <% } else { %>
          (no title)
        <% } %>
      </div>
    </a>
  <% } %>
  <% if (post.next){ %>
    <a href="<%- url_for(post.next.path) %>" id="article-nav-newer" class="article-nav-link-wrap w-full md:w-auto text-nowrap text-right">
      <strong class="article-nav-caption"><%= __('newer') %></strong>
      <div class="article-nav-title"><%= post.next.title %></div>
    </a>
  <% } %>
</nav>
<% } %>
