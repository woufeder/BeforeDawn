<header id="header">
  <div id="banner"></div>
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <h1 id="logo-wrap">
        <a href="<%- bd_url_for_lang('/') %>" id="logo"><%= config.title %></a>
      </h1>
      <% if (theme.subtitle || config.subtitle){ %>
        <h2 id="subtitle-wrap">
          <a href="<%- bd_url_for_lang('/') %>" id="subtitle"><%= theme.subtitle || config.subtitle %></a>
        </h2>
      <% } %>
    </div>
    <div id="header-inner" class="inner">
<!--  -->
      <nav id="main-nav">
        <a id="main-nav-toggle" class="nav-icon"><span class="fa fa-bars"></span></a>
        <% for (var i in theme.menu){ %>
          <% if (i === 'original') { %>
            <div class="main-nav-item has-submenu">
              <a class="main-nav-link" href="<%- bd_url_for_lang(theme.menu[i]) %>"><%= bd_label(i) %></a>
              <div class="main-nav-submenu">
                <a class="main-nav-submenu-link" href="<%- bd_url_for_lang('/blog/') %>"><%= bd_label('blog') %></a>
              </div>
            </div>
          <% } else { %>
            <a class="main-nav-link" href="<%- bd_url_for_lang(theme.menu[i]) %>"><%= bd_label(i) %></a>
          <% } %>
        <% } %>
      </nav>

      <!-- <nav id="sub-nav">
        <% if (theme.links) { %>
          <% for (const i in theme.links) {%>
            <a class="nav-icon" href="<%- url_for(theme.links[i]) %>"><span class="fa fa-<%= i %>"></span></a>
          <% } %>
        <% } %>

        <a class="nav-icon nav-search-btn" title="<%= bd_label('search') %>"><span class="fa fa-search"></span></a>
      </nav> -->
      <div id="search-form-wrap">
        <%- search_form({button: '&#xF002;', text: bd_label('search')}) %>
      </div>
    </div>
  </div>
</header>
