<%
const submenus = {
  original: [
    { key: 'Jatorri', url: '/Original/Jatorri/' },
    { key: 'Incessant_Breeze', url: '/Original/Incessant_Breeze/' },
    { key: 'Final_Oath', url: '/Original/Final_Oath/' },
    { key: 'TTOP', url: 'https://afterthelight.wixsite.com/ttop' },
    { key: 'Sunrise_After_Rain', url: '/Original/Sunrise_After_Rain/' },
    { key: 'Endless_Voice', url: '/Original/Endless_Voice/' },
    { key: 'Miscellanies', url: '/Miscellanies/' },
    { key: 'blog', url: '/blog/' },
  ],
  project: [
    { key: 'VCA', url: '/Project/VCA/' },
    { key: 'DUETTA-Lilin', url: '/Project/DUETTA-Lilin/' },
    { key: 'DUETTA-Naxira', url: '/Project/DUETTA-Naxira/' },
    { key: 'AG', url: '/Project/AG/' },
    { key: 'ST', url: '/Project/ST/' },
    { key: 'DL', url: '/Project/DL/' },
    { key: 'YMSH', url: '/Project/YMSH/' },
    { key: 'Sappho-Audrey', url: '/Project/Sappho-Audrey/' },
    { key: 'Sappho-Yana', url: '/Project/Sappho-Yana/' },
  ]
};

const currentPath = page.path || '';

function switchLang(targetLang) {
const rawPath = String(page.path || '');

const pathWithoutLang = rawPath
.replace(/^\/?BeforeDawn\/?/i, '')
.replace(/^(zh-tw|en|it)\//i, '')
.replace(/index\.html$/i, '')
.replace(/^\/+/, '');

return url_for('/' + targetLang + '/' + pathWithoutLang);
}


function cleanPath(path) {
  return String(path || '')
    .replace(/^https?:\/\/[^/]+/, '')
    .replace(/^\/?BeforeDawn\/?/i, '')
    .replace(/^\/+/, '')
    .replace(/^(zh-tw|en|it)\//i, '')
    .replace(/index\.html$/i, '')
    .replace(/\/+$/, '')
    .toLowerCase();
}

const activePath = cleanPath(page.path);

function isActiveUrl(url) {
  const targetPath = cleanPath(url);
  if (!targetPath) return false;

  return activePath === targetPath || activePath.startsWith(targetPath + '/');
}

function getSubmenu(key) {
  return submenus[String(key).toLowerCase()];
}
%>



<header id="header" class="">
  <div class="container flex flex-row h-full">

    <!-- Desktop -->

    <div id="logo">
      <a href="<%= url_for('/' + page.lang + '/') %>" class="flex flex-col w-fit no-swup" data-no-swup>
        <h2 class="w-fit">夜明曉更前</h2>
        <h4 class="subLogo w-fit">Anyway Before Dawn</h4>
      </a>
    </div>

    <div class="ms-auto w-full hidden md:flex flex-col items-end justify-end ">
      <div class="lang-switch flex flex-row items-center gap-1 mb-auto">
        <svg class="lang-globe" viewBox="0 0 24 24" role="img" aria-label="globe">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" />
          <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M3 12h18M5.5 7.5h13M5.5 16.5h13" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>

        <select id="lang-select" class="lang-select-control" aria-label="Language" onchange="if(this.value){location.href=this.value;}">
          <option value="<%= switchLang('zh-tw') %>" <%= page.lang === 'zh-tw' ? 'selected' : '' %>>ZH</option>
          <option value="<%= switchLang('en') %>" <%= page.lang === 'en' ? 'selected' : '' %>>EN</option>
          <option value="<%= switchLang('it') %>" <%= page.lang === 'it' ? 'selected' : '' %>>IT</option>
        </select>
      </div>

      <% if (page.lang === 'zh-tw') { %>
      <div class="zh-only-note flex flex-row items-end justify-end">
        <div class="nav-note">
          <p>小船住民</p>
        </div>
        <div class="nav-note">
          <p>銀海塵沙</p>
        </div>
        <div class="nav-note">
          <p>旅行者書</p>
        </div>
        <div class="nav-note">
          <p>星梢夜歌</p>
        </div>
        <div class="nav-note">
          <p>流光之外</p>
        </div>
      </div>
      <% } %>

      <nav id="main-nav">
        <% for (var i in theme.menu) { %>
        <% if (i === 'home') continue; %>

        <%
            const submenu = getSubmenu(i);
            const hasSubmenu = Array.isArray(submenu);

            const mainActive = isActiveUrl(theme.menu[i]);
            const subActive = hasSubmenu && submenu.some(function(sub) {
              return isActiveUrl(sub.url);
            });

            const itemActive = mainActive || subActive;
          %>

        <% if (hasSubmenu) { %>
        <div class="main-nav-item has-submenu <%= itemActive ? 'is-active' : '' %>">
          <a class="main-nav-link <%= itemActive ? 'is-active' : '' %>" href="<%- bd_url_for_lang(theme.menu[i]) %>">
            <%= bd_i18n(i) %>
          </a>

          <div class="main-nav-submenu">
            <% submenu.forEach(function(sub) { %>
            <%
                    const thisSubActive = isActiveUrl(sub.url);
                  %>

            <a class="main-nav-submenu-link <%= thisSubActive ? 'is-active' : '' %>" href="<%- bd_url_for_lang(sub.url) %>" <%- sub.key === 'blog' ? 'data-no-swup' : '' %>>
              <%= bd_i18n(sub.key) %>
            </a>
            <% }) %>
          </div>
        </div>
        <% } else { %>
        <a class="main-nav-link <%= itemActive ? 'is-active' : '' %>" href="<%- bd_url_for_lang(theme.menu[i]) %>">
          <%= bd_i18n(i) %>
        </a>
        <% } %>
        <% } %>
      </nav>
    </div>

    <!-- mobile trigger -->
    <button id="mobile-menu-toggle" class="flex md:hidden">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- overlay -->
    <div id="mobile-menu-overlay"></div>

    <!-- offcanvas -->
    <nav id="mobile-menu" aria-label="Mobile navigation">
      <div class="mobile-menu-inner">
        <div class="mobile-lang-switch">
          <svg class="lang-globe" viewBox="0 0 24 24" role="img" aria-label="globe">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" />
            <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path d="M3 12h18M5.5 7.5h13M5.5 16.5h13" fill="none" stroke="currentColor" stroke-width="1.4" />
          </svg>

          <select class="mobile-lang-select" aria-label="Language" onchange="if(this.value){location.href=this.value;}">
            <option value="<%= switchLang('zh-tw') %>" <%= page.lang === 'zh-tw' ? 'selected' : '' %>>
              中文
            </option>

            <option value="<%= switchLang('en') %>" <%= page.lang === 'en' ? 'selected' : '' %>>
              English
            </option>

            <option value="<%= switchLang('it') %>" <%= page.lang === 'it' ? 'selected' : '' %>>
              Italiano
            </option>
          </select>
        </div>
        <% for (var i in theme.menu) { %>
        <% if (i === 'home') continue; %>

        <%
      const submenu = getSubmenu(i);
      const hasSubmenu = Array.isArray(submenu);

      const mainActive = isActiveUrl(theme.menu[i]);
      const subActive = hasSubmenu && submenu.some(function(sub) {
        return isActiveUrl(sub.url);
      });

      const itemActive = mainActive || subActive;
    %>

        <% if (hasSubmenu) { %>
        <details class="mobile-collapse <%= itemActive ? 'is-active' : '' %>">
          <summary class="mobile-summary">
            <span><%= bd_i18n(i) %></span>
          </summary>

          <div class="mobile-submenu">
            <a class="mobile-parent-link <%= mainActive ? 'is-active' : '' %>" href="<%- bd_url_for_lang(theme.menu[i]) %>">
              <%= bd_i18n(i) %>
            </a>

            <% submenu.forEach(function(sub) { %>
            <%
              const thisSubActive = isActiveUrl(sub.url);
            %>

            <a class="<%= thisSubActive ? 'is-active' : '' %>" href="<%- bd_url_for_lang(sub.url) %>" <%- sub.key === 'blog' ? 'data-no-swup class="no-swup"' : '' %>>
              <%= bd_i18n(sub.key) %>
            </a>
            <% }) %>
          </div>
        </details>
        <% } else { %>
        <a class="mobile-link <%= itemActive ? 'is-active' : '' %>" href="<%- bd_url_for_lang(theme.menu[i]) %>">
          <%= bd_i18n(i) %>
        </a>
        <% } %>

        <% } %>

      </div>
    </nav>


  </div>
</header>