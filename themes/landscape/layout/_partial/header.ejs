<% const submenus={ 
  original: [ 
  { key: 'Jatorri' , url: '/Original/Jatorri/' }, 
  { key: 'IncresseBrezze' , url: '/Original/IncresseBrezze/' }, 
  { key: 'IncresseBrezze' , url: '/Original/IncresseBrezze/' }, 
  { key: 'IncresseBrezze' , url: '/Original/IncresseBrezze/' }, 
  { key: 'blog' , url: '/blog/' }, 
  ], 
  project: [ 
   {key: 'VCA' , url: '/Project/VCA/' }, 
   ] }; %>

<% const currentPath=page.path || '' ; // 例如：zh-tw/about/index.html 
  function switchLang(targetLang) { return url_for(
    currentPath.replace(/^([a-z\-]+)\//, targetLang + '/' ) ); } %>

<header id="header" class=" ">
  <div class="container flex flex-row h-full">
    <div id="logo">
      <a href="<%= url_for('/' + page.lang + '/') %>" class="flex flex-col w-fit">
        <h2 class="w-fit">夜明曉更前</h2>
        <h4 class="subLogo w-fit">Anyway Before Dawn</h4>
      </a>
    </div>

    <div class="ms-auto w-full flex flex-col items-end justify-end">
      <div class="lang-switch flex flex-row items-center gap-1 mb-auto">
        <svg class="lang-globe" viewBox="0 0 24 24" role="img" aria-label="globe">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" />
          <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M3 12h18M5.5 7.5h13M5.5 16.5h13" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <select id="lang-select" class="lang-select-control" aria-label="Language" onchange="if(this.value){location.href=this.value;}">
          <option value="<%= switchLang('zh-tw') %>" <%=page.lang==='zh-tw' ? 'selected' : '' %>>ZH</option>
          <option value="<%= switchLang('en') %>" <%=page.lang==='en' ? 'selected' : '' %>>EN</option>
          <option value="<%= switchLang('it') %>" <%=page.lang==='it' ? 'selected' : '' %>>IT</option>
        </select>

      </div>
      <% if (page.lang==='zh-tw' ) { %>
      <div class="zh-only-note flex flex-row items-end justify-end">
        <div class="nav-note">
          <p>小船住民</p>
        </div>
        <div class="nav-note">
          <p>銀海塵沙</p>
        </div>
        <div class="nav-note">
          <p>旅行者書</p>
        </div>
        <div class="nav-note">
          <p>星梢夜歌</p>
        </div>
        <div class="nav-note">
          <p>流光之外</p>
        </div>
      </div>
      <% } %>
      <nav id="main-nav">
        <a id="main-nav-toggle" class="nav-icon"><span class="fa fa-bars"></span></a>
        <% for (var i in theme.menu){ if (i==='home' ) continue;%>

        <% if (submenus[i]) { %>
        <div class="main-nav-item has-submenu">
          <a class="main-nav-link" href="<%- bd_url_for_lang(theme.menu[i]) %>">
            <%= bd_i18n(i) %>
          </a>
          <div class="main-nav-submenu">
            <% submenus[i].forEach(sub=> { %>
            <a class="main-nav-submenu-link" href="<%- bd_url_for_lang(sub.url) %>">
              <%= bd_i18n(sub.key) %>
            </a>
            <% }) %>
          </div>
        </div>
        <% } else { %>
        <a class="main-nav-link" href="<%- bd_url_for_lang(theme.menu[i]) %>">
          <%= bd_i18n(i) %>
        </a>
        <% } %>
        <% } %>




      </nav>
    </div>
  </div>
</header>