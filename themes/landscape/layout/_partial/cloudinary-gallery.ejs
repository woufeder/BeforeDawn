<script>
  (function() {
    const cloudName = 'dhtsewjf1';
    const tag = '<%- tag %>';

    const captions = <%- JSON.stringify(captions || {}) %>;

    async function loadGallery() {
      const gallery = document.getElementById('gallery');

      if (!gallery) return;

      gallery.innerHTML = '<div class="gallery-sizer"></div>';

      try {
        const res = await fetch(
          `https://res.cloudinary.com/${cloudName}/image/list/${tag}.json`
        );

        const data = await res.json();

        const base =
          `https://res.cloudinary.com/${cloudName}/image/upload/`;

        data.resources.sort((a, b) => a.version - b.version);

        data.resources.forEach(item => {
          const ext = item.format;

          const publicId = item.public_id.split('/').pop();

          const full =
            `${base}${item.public_id}.${ext}`;

          const thumb =
            `${base}q_auto,f_auto,w_400/${item.public_id}.${ext}`;

          const caption =
            captions[publicId] || '';

          const itemDiv = document.createElement('div');
          itemDiv.className = 'gallery-item';

          const a = document.createElement('a');

          a.href = full;

          a.setAttribute(
            'data-fancybox',
            'gallery'
          );

          if (caption) {
            a.setAttribute(
              'data-caption',
              caption
            );
          }

          const img = document.createElement('img');

          img.src = thumb;
          img.alt = caption;

          img.loading = 'lazy';
          img.decoding = 'async';

          a.appendChild(img);
          itemDiv.appendChild(a);
          gallery.appendChild(itemDiv);
        });

        imagesLoaded(gallery, function() {
          new Masonry(gallery, {
            itemSelector: '.gallery-item',
            columnWidth: '.gallery-sizer'
          });
        });

        if (window.Fancybox) {
          Fancybox.bind('[data-fancybox="gallery"]');
        }

      } catch (err) {
        console.error(
          '[Cloudinary Gallery Error]',
          err
        );
      }
    }

    loadGallery();
  })();
</script>