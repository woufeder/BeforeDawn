---
layout: false
---

<!DOCTYPE html>
<html lang="<%= page.lang || config.language || 'zh-TW' %>">

<head>
  <link rel="icon" href="<%= url_for('/favicon.ico') %>">
  <%- partial('_partial/google-analytics') %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= page.title %>
  </title>
  <%- partial('_partial/assets') %>
  <link rel="stylesheet" href="<%- url_for('assets/css/main.css') %>" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.css" />
  <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.umd.js"></script>
  <style>
    html.is-changing .transition-fade {
      opacity: 1;
    }

    /* Define the styles for the unloaded pages */
    html.is-animating .transition-fade {
      opacity: 1;
    }
  </style>
</head>

<body>
  <div id="swup" class="transition-fade" style="
    --bg-image: url('<%= url_for(page.bg || '/image/bg-base.jpg') %>');
    --bg-color: <%= page.bgColor || 'rgba(35,36,61,0.9)' %>;
    --bg-blend: <%= page.bgBlend || 'multiply' %>;
    --text-color: <%= page.textColor || '#f0f0f0' %>;
    --text-color-hover: <%= page.textColorHover || '#f0f0f099' %>;
    --menu-active-color: <%= page.menuActiveColor || 'rgba(105, 120, 170, 0.5)' %>;
    --shadow-chinese: <%= page.shadowChinese || '0 0 6px rgba(255, 255, 255, 1)' %>;
    --shadow-latin: <%= page.shadowLatin || '0 0 5px rgba(255, 255, 255, 0.8), 0 0 5px rgba(255, 255, 255, 0.8)' %>;
  ">

    <%- partial('_partial/header') %>

    <main class="container .fade-in-once-nodely py-10"><%- body %></main>

    <%- partial('_partial/footer') %>

  </div>
  <script src="<%- url_for('js/micromodal.min.js') %>"></script>
  <script>
    MicroModal.init({});
  </script>
  <script src="https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js"></script>
  <script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>
  <script src="https://unpkg.com/swup@4"></script>
  <script src="https://unpkg.com/@swup/scripts-plugin@2"></script>
  <script data-swup-ignore-script>
    const swup = new Swup({
      plugins: [new SwupScriptsPlugin({
        body: true,
        head: false
      })],
      animationSelector: false
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        // 從 bfcache 回來
        window.location.reload();
      }
    });
  </script>
  <script>
    window.initPage = function() {
      if (typeof loadGallery === 'function') {
        loadGallery();
      }
    };

    document.addEventListener('DOMContentLoaded', window.initPage);

    // 👉 只綁一次！
    function bindSwupOnce() {
      if (!window.swup) {
        setTimeout(bindSwupOnce, 50);
        return;
      }

      if (window.swup.hooks) {
        window.swup.hooks.on('page:view', window.initPage);
      } else if (window.swup.on) {
        window.swup.on('contentReplaced', window.initPage);
      }
    }

    bindSwupOnce();
  </script>
</body>

</html>