---
layout: page/layout
---
<% function projectPageUrl(path) { return !path ? '' : /^(?:https?:|mailto:|#)/i.test(path) ? path : url_for('/' + page.lang + (path.charAt(0) === '/' ? path : '/' + path)); } %>
<section id="<%= page.pId %>" class="project-detail <%= page.theme || '' %>" style="<% if (page.quoteColor) { %>--quote-color: <%= page.quoteColor %>;<% } %> <% if (page.brushColor) { %>--brush-color: <%= page.brushColor %>;<% } %>">
  <!-- 回到上一頁按鈕 -->
  <a class="project-back" href="<%= url_for('/' + page.lang + '/Project/') %>" aria-label="<%= page.backBtn %>"><svg fill="currentColor" width="36" height="36" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M48,256c0,114.87,93.13,208,208,208s208-93.13,208-208S370.87,48,256,48,48,141.13,48,256Zm252-74.14V330.14a16,16,0,0,1-26.23,12.29L184.68,268.3a16,16,0,0,1,0-24.6l89.09-74.13A16,16,0,0,1,300,181.86Z" />
    </svg></a>
    
  <div class="top-section">
    <div class="project-portrait"><% if (page.settingFullImage) { %><a href="<%= url_for(page.settingFullImage) %>" data-fancybox="setting" data-no-swup><% } %><img src="<%= url_for(page.settingImage) %>" alt=""><% if (page.settingFullImage) { %></a><% } %></div>
    <div class="project-intro">
      <div class="name-heading">
        <h1><%= page.Name %></h1>
        <% if (page.enName && page.enName.trim()) { %><h2 class="character-english"><%= page.enName %></h2><% } %>
      </div>
      <% if (page.quote) { %><p class="character-quote"><%= page.quote %></p><% } %>
      <div class="profile-columns">
        <div class="profile-info">
        <div class="profile-block">
          <ul class="profile-facts">
            <% (page.intro || []).forEach(function(fact) { %><li><% if (fact.url) { %><%= fact.label || '' %><a href="<%= fact.url %>"><%= fact.text %></a><% } else { %><%= fact.text %><% } %></li><% }) %>
          </ul>
        </div>
        <div class="profile-block">
          <ul class="profile-appearance">
            <% (page.appearance || []).forEach(function(item) { %><li><%= item %></li><% }) %>
          </ul>
        </div>
        <div class="project-labels">
          <% if (page.label1Text && page.label1Text.trim()) { %><a href="<%= projectPageUrl(page.label1Url) %>"><%= page.label1Text %></a><% } %>
          <% if (page.label2Text && page.label2Text.trim()) { %><a href="<%= projectPageUrl(page.label2Url) %>"><%= page.label2Text %></a><% } %>
        </div>
        </div>
        <% if (page.chibiImage) { %><div class="project-chibi"><% if (page.chibiArtist && page.chibiArtistUrl) { %><a class="chibi-artist" href="<%= page.chibiArtistUrl %>"><%= page.chibiArtist %></a><% } else if (page.chibiArtist) { %><span class="chibi-artist"><%= page.chibiArtist %></span><% } %><a class="chibi-image" href="<%= url_for(page.chibiImage) %>" data-fancybox="gallery" data-no-swup data-caption="<%= page.chibiArtist || '' %>"><img src="<%= url_for(page.chibiImage) %>" alt=""></a></div><% } %>
      </div>
    </div>
  </div>
  <div class="bottom-sections">
    <section class="project-section" id="biography">
      <div class="section-heading">
        <h2>BIOGRAPHY</h2><% if (page.cPlurkIcon && page.cPlurk) { %><a href="<%= page.cPlurk %>" aria-label="<%= page.cPlurkLinkText %>" title="<%= page.cPlurkLinkText %>"><span aria-hidden="true" class="character-icon" style="-webkit-mask-image:url('<%= url_for(page.cPlurkIcon) %>');mask-image:url('<%= url_for(page.cPlurkIcon) %>')"></span></a><% } %>
      </div>
      <p><%- page.biography %></p>
      <% const relatedCharacters = page.relatedCharacters || (page.anotherCLinkk && page.anotherCLabel ? [{url: page.anotherCLinkk, label: page.anotherCLabel}] : []); %>
      <% relatedCharacters.forEach(function(character) { %><a class="project-related" href="<%= projectPageUrl(character.url) %>"><%= character.label %></a><% }) %>
    </section>
    <section class="project-section" id="about-project">
      <div class="section-heading">
        <h2>ABOUT PROJECT</h2><% if (page.projectUrl) { %><a href="<%= page.projectUrl %>" aria-label="<%= page.projectLinkText || page.projectLinkLabel %>" title="<%= page.projectLinkText || page.projectLinkLabel %>"><svg fill="currentColor" width="32px" height="32px" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="hover:opacity-70 transition-opacity duration-300">
            <path d="M17.203 2.542c-4.073-0.031-7.938 1.786-10.505 4.943-0.13 0.156-0.255 0.313-0.38 0.474h0.005c0.313-0.266 0.63-0.464 0.958-0.594l0.078-0.031c0.396-0.151 0.802-0.198 1.198-0.12 1.922 0.385 2.922 3.479 2.234 6.911s-2.802 5.901-4.719 5.521c-1.349-0.271-2.24-1.875-2.417-3.99v-0.010 0.073c-0.005 0.177-0.005 0.354 0 0.531v0.177c0.005 0.198 0.021 0.396 0.031 0.589 0.010 0.089 0.016 0.182 0.026 0.271 0.151 1.594 0.583 3.146 1.281 4.589 0.083 0.167 0.042 0.37-0.104 0.484l-0.37 0.302c-0.38 0.313-0.531 0.823-0.385 1.292 0 0.010 0.005 0.016 0.010 0.021 0.021 0.068 0.047 0.13 0.078 0.193l0.068-0.052 0.302-0.234c0.37-0.281 0.792 0.276 0.422 0.557l-0.323 0.245-0.052 0.036 1.568 1.932c0.427 0.516 1.182 0.594 1.703 0.177l0.344-0.281c0.146-0.12 0.354-0.12 0.5 0 2.469 1.964 5.547 2.995 8.703 2.906 2.667-0.063 5.25-0.927 7.427-2.474 0.156-0.109 0.37-0.094 0.505 0.036l0.219 0.208c0.432 0.406 1.099 0.443 1.573 0.078l-0.005-0.005-0.281-0.266c-0.313-0.318 0.141-0.797 0.479-0.505l0.297 0.276 1.682-1.766c0.458-0.484 0.438-1.25-0.047-1.708l-0.349-0.333c-0.13-0.125-0.161-0.323-0.073-0.479 1.505-2.708 2.021-5.849 1.474-8.896 0.401-0.37 1.135-1.099 1.422-1.724 0.307-0.667 0.391-1.359-0.427-1.057-0.635 0.24-1.125 0.391-1.719 0.255-1.885-4.792-6.458-8.255-11.797-8.531-0.214-0.016-0.422-0.021-0.635-0.021zM3.021 8.328c-1.198 0.021-1.964 1.276-1.443 2.354-1.094 0.042-1.844 1.125-1.49 2.161 0.349 1.036 1.599 1.448 2.495 0.818 0.234-0.167 0.406-0.385 0.526-0.625 0.25 0.453 0.615 0.833 1.036 1.099-0.005 0.266 0 0.531 0.026 0.797 0.135 1.641 0.823 2.88 1.865 3.089 1.484 0.297 3.12-1.615 3.651-4.266 0.531-2.656-0.24-5.047-1.724-5.344-0.583-0.115-1.182 0.109-1.734 0.578-0.599 0.51-1.135 1.318-1.521 2.307-0.010-0.005-0.026-0.005-0.036-0.010-0.188-0.052-0.286-0.177-0.417-0.203 0.979-1.063 0.208-2.781-1.234-2.755zM6.839 9.99c0.068 0 0.141 0.005 0.208 0.021 0.969 0.188 1.474 1.745 1.13 3.474-0.349 1.729-1.411 2.974-2.38 2.781-0.656-0.13-1.099-0.896-1.208-1.911 0.245 0.094 0.495 0.151 0.75 0.161 0.703 0.031 1.161-0.203 1.521-0.682 0.458-0.62 0.109-2.339-0.5-2.563-0.474-0.172-0.755 0.036-1.177 0.068 0.214-0.396 0.464-0.724 0.74-0.958 0.292-0.245 0.604-0.391 0.917-0.396z" />
          </svg></a><% } %>
      </div>
      <div class="project-meta">
        <h3><%= page.projectName %></h3><span><%= page.projectPeriod %></span>
      </div>
      <p><%- page.projectDescription %></p>
      <p class="project-tags"><%= page.projectTags %></p>
    </section>
    <section class="project-section" id="illustration">
      <h2>ILLUSTRATION</h2>
      <div id="gallery">
        <div class="gallery-sizer"></div>
      </div>
    </section>
    <section class="project-section" id="story">
      <h2>STORY</h2><%- partial('_partial/post-category-pager', { id: 'story', category: page.storyCategories, perPage: page.storyPerPage, listClass: '', prevText: page.previousText, nextText: page.nextText }) %>
    </section>
  </div>
</section>
<%- partial('_partial/cloudinary-gallery', { tag: page.galleryTag, captions: page.galleryCaptions }) %>
