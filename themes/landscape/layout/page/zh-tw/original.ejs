<section>
  <button class="hasborder">
    123
  </button>

  <div id="gallery"></div>
</section>
<script>
(function () {
  const cloudName = 'dhtsewjf1';
  const tag = 'others';

  async function loadGallery() {
    const gallery = document.getElementById('gallery');
    if (!gallery) return;

    // 每次進頁直接清空
    gallery.innerHTML = '';

    try {
      const res = await fetch(
        `https://res.cloudinary.com/${cloudName}/image/list/${tag}.json`
      );
      const data = await res.json();

      const base = `https://res.cloudinary.com/${cloudName}/image/upload/`;

      data.resources.forEach((item) => {
        const full = base + item.public_id + '.jpg';
        const thumb =
          base + 'q_auto,f_auto,w_400/' + item.public_id + '.jpg';

        const a = document.createElement('a');
        a.href = full;
        a.setAttribute('data-fancybox', 'gallery');
        a.setAttribute('data-no-swup', '');

        const img = document.createElement('img');
        img.src = thumb;

        a.appendChild(img);
        gallery.appendChild(a);
      });

      if (window.Fancybox) {
        Fancybox.bind('[data-fancybox="gallery"]', {});
      }

    } catch (err) {
      console.error(err);
    }
  }

  // 👉 唯一入口（關鍵）
  loadGallery();

})();
</script>