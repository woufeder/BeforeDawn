---
layout: page/layout
---
<%
  const shortStoryData = site.data.short_stories || {};
  const shortStories = shortStoryData.stories || [];
  const overview = shortStoryData.overview || {};
  const currentLang = page.lang || 'zh-tw';
  function i18nContent(value) {
    if (value == null) return '';
    if (typeof value === 'string') {return value;}
    return value[currentLang] || value['zh-tw'] || Object.values(value)[0] || '';
  }
  function terminologyUrl(target) {
    const work = String(target).match(/^\/?Original\/([^/#?]+)\/?(?:[?#]|$)/i);
    if (!work) return bd_url_for_lang(target);
    const expectedSource = (String(page.lang || 'zh-tw') + '/Original/' + work[1] + '/index.md').toLowerCase();
    const exists = site.pages.toArray().some(function(item) {
      return String(item.source || '').replace(/\\/g, '/').toLowerCase() === expectedSource;
    });
    return bd_url_for_lang(target, exists ? page.lang : 'zh-tw');
  }
%>
<div id="short-stories" class='fade-in-once' style="--box-bg-color: <%= page.blockBgColor %>;">
  <section id="banner" class="box short-stories-overview" aria-label="<%= bd_i18n('Short_Stories') %>">
    <div class="left">
      <h1>Short Stories</h1>
      <% if (bd_i18n('Short_Stories') !== 'Short Stories') { %><h2><%= bd_i18n('Short_Stories') %></h2><% } %>
    </div>
    <div class="right flex flex-col items-center">
      <div class="hover-box flex flex-col items-center gap-8 text-center w-fit px-4 xl:px-0" data-mobile-toggle="hover-box">
        <%- partial('_partial/svg/branch_top') %>
        <div class="grid">
          <div class="context default flex items-center justify-center">
            <p class="short-overview-text"><%= i18nContent(overview.intro) || '' %></p>
          </div>
          <div class="context hover flex items-center justify-center">
            <p class="short-overview-text"><%= i18nContent(overview.details) || '' %></p>
          </div>
        </div>
        <%- partial('_partial/svg/branch_bottom') %>
      </div>
    </div>
  </section>

  <nav class="short-stories-nav" aria-label="<%= bd_i18n('short_stories.navigation') %>">
    <% shortStories.forEach(function(story) { %>
    <a href="#<%= story.id %>" data-no-swup><span><%= bd_i18n(story.titleKey) %></span></a>
    <% }); %>
  </nav>

  <div class="short-stories-content">
    <% shortStories.forEach(function(story) {
      const characters = Array.isArray(story.characters) ? story.characters : [];
      const illustrations = Array.isArray(story.illustrations) ? story.illustrations.filter(function(item) { return item && item.url; }) : [];
      const terms = story.terminology || {};
      const termItems = Array.isArray(terms.items) ? terms.items : [];
      const hasTerms = terms.show === true || !!terms.url || termItems.length > 0;
      const galleryId = 'short-gallery-' + story.id;
      const galleryGroup = 'short-illustration-' + story.id;
      let hasPosts = false;
      site.posts.each(function(post) {
        if (hasPosts || bd_post_lang(post) !== 'zh-tw') return;
        post.categories.each(function(category) {
          if (String(category.name || '').trim() === story.category) hasPosts = true;
        });
      });
    %>
    <section class="short-story box" id="<%= story.id %>" aria-labelledby="<%= story.id %>-title">
      <header class="short-story-intro">
        <h2 id="<%= story.id %>-title"><%= bd_i18n(story.titleKey) %></h2>
        <%const storyIntro = i18nContent(story.intro);%>
        <% if (storyIntro) { %>
        <p><%= storyIntro %></p>
        <% } %>
      </header>

      <div class="short-story-info<%= hasTerms ? ' has-terminology' : '' %>">
        <div class="short-story-characters">
          <h3><%= bd_i18n('short_stories.characters') %></h3>
          <% if (characters.length) { %>
          <%- partial('_partial/oc/collection', {
              characterDirectory: 'Short_Stories/' + story.id,
              collectionId: 'short-' + story.id,
              cards: characters
            }) %>
          <% } else { %><p class="short-story-empty"><%= bd_i18n('short_stories.no_characters') %></p><% } %>
        </div>
        <% if (hasTerms) { %>
        <div class="short-story-terminology">
          <h3><%= bd_i18n('short_stories.terminology') %></h3>
          <% if (terms.url) { %><a class="short-story-terms-link" href="<%= terminologyUrl(terms.url) %>" data-no-swup><%= i18nContent(terms.linkText) || bd_i18n('short_stories.related_terminology') %> ↗</a><% } %>
          <% if (termItems.length) { %><div class="noun-list">
            <table>
              <tbody>
                <% termItems.forEach(function(term) { %><tr>
                  <th scope="row"><%= i18nContent(term.name) %></th>
                  <td><%= i18nContent(term.description) %></td>
                </tr><% }); %>
              </tbody>
            </table>
          </div><% } %>
          <% if (!terms.url && !termItems.length) { %><p class="short-story-empty"><%= bd_i18n('short_stories.no_terminology') %></p><% } %>
        </div>
        <% } %>
      </div>

      <div class="short-story-works">
        <section aria-labelledby="<%= story.id %>-illustration-title">
          <h3 id="<%= story.id %>-illustration-title"><%= bd_i18n('short_stories.illustration') %></h3>
          <% if (illustrations.length || story.galleryTag) { %>
          <div id="<%= galleryId %>" class="short-story-gallery" <%- story.galleryTag ? '' : ' data-static-gallery' %>>
            <% illustrations.forEach(function(item) { %>
            <div class="gallery-item"><a href="<%= url_for(item.url) %>" data-fancybox="<%= galleryGroup %>" data-no-swup<% if (item.caption) { %> data-caption="<%= i18nContent(item.caption) %>" <% } %>><img src="<%= url_for(item.thumbnail || item.url) %>" alt="<%= i18nContent(item.caption) || '' %>" loading="lazy" decoding="async"></a></div>
            <% }); %>
          </div>
          <% if (story.galleryTag) { %><%- partial('_partial/cloudinary-gallery', { tag: story.galleryTag, captions: story.captions || {}, galleryId: galleryId, galleryGroup: galleryGroup, useMasonry: false }) %><% } %>
          <% } else { %><p class="short-story-empty"><%= bd_i18n('short_stories.no_illustrations') %></p><% } %>
        </section>
        <section aria-labelledby="<%= story.id %>-story-title">
          <h3 id="<%= story.id %>-story-title"><%= bd_i18n('short_stories.story') %></h3>
          <% if (hasPosts) { %>
          <%- partial('_partial/post-category-pager', {
              id: 'short-posts-' + story.id,
              articleIdPrefix: 'short-' + story.id + '-',
              category: [story.category],
              postLang: 'zh-tw',
              perPage: 5,
              hideSinglePage: true,
              prevText: bd_i18n('short_stories.previous'),
              nextText: bd_i18n('short_stories.next')
            }) %>
          <% } else { %><p class="short-story-empty"><%= bd_i18n('short_stories.no_stories') %></p><% } %>
        </section>
      </div>
    </section>
    <% }); %>
  </div>

  <script>
    (function() {
      var root = document.getElementById('short-stories');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = 'true';
      var links = Array.from(root.querySelectorAll('.short-stories-nav a'));
      var sections = Array.from(root.querySelectorAll('.short-story'));
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (!entry.isIntersecting) return;
            links.forEach(function(link) {
              if (link.getAttribute('href') === '#' + entry.target.id) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          });
        }, {
          rootMargin: '-20% 0px -70% 0px'
        });
        sections.forEach(function(section) {
          observer.observe(section);
        });
      }
      if (window.Fancybox) {
        root.querySelectorAll('[data-static-gallery]').forEach(function(gallery) {
          Fancybox.bind(gallery, '[data-fancybox]');
        });
      }
    })();
  </script>
</div>
