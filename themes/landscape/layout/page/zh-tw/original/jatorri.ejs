];
  const ocPages = site.pages.toArray().filter(function(item) {
    return item.source && item.source.startsWith('zh-tw/Original/Jatorri/') && item.character;
  });
  const ocEntries = ocCards.map(function(card, index) {
    const characterPage = ocPages.find(function(item) {
      return item.character.cardId ? String(item.character.cardId).toLowerCase() === card.id : item.character.name === card.name;
    });
    return { card: card, page: characterPage, dialogId: 'oc-character-dialog-' + (index + 1), idPrefix: 'oc-character-' + (index + 1) };
  });
%>

<section id="jatorri" style="--box-bg-color: <%= page.blockBgColor %>;" class="fade-in-once">
  <section id="banner" class="box">
    <div class="left">
      <h1>Jatorri</h1>
    </div>
    <div class="right flex flex-col items-center">
      <div class="hover-box flex flex-col items-center gap-8 text-center w-fit px-4 xl:px-0" data-mobile-toggle="hover-box">
        <%- partial('_partial/svg/branch_top') %>
        <div class="grid">
          <div class="context default flex items-center justify-center">
            <h6>
              天地初始，自光明處誕兩神──創生與破滅。<br>
              兩神將餘下黑暗塑成一體，即為不敗女神。<br><br>
              漫長的時間流逝，厭倦天上界的女神捨去頂上金冠，<br>與隨其而去的死神一同進入輪迴，降生為人。<br><br>
              為融入人界的生活，同時履行不敗女神的職責──鎮壓且平衡光與影的流動。<br>她與一眾追隨者創立「暗中守護世界」的團隊。這便是最初的「亞托利」。<br><br>
              亞托利軍事組織，奉行女神對人間的愛，至今依舊在不知名的角落默默守護著這個世界。<br>
              <span>一切的故事，皆紀載於女神的世界之書上，緩緩前行。</span>
            </h6>
          </div>
          <div class="context hover flex flex-col items-center justify-center">
            <h6 class="text-center">
              參照現實的半架空奇幻，可以視為具魔法元素的平行現代。<br><br>
              設定上每個人與生俱來或多或少都有魔法的天賦，但多數人的天賦稀微到會被視為非魔法的存在。<br>
              (如高敏感、聯覺，特別準的直覺，這些人格特質也是法力天賦的一部份。)<br><br>
              Jatorri的神話觀凌駕於其餘的原創世界觀。<br>
              意即本世界觀通用於其餘所有創作，無論該創作是否具魔法元素皆然，且常有角色客串。<br><br>
              極少更新，沒有主線，更新以日常互動為主。
            </h6>
          </div>
        </div>
        <%- partial('_partial/svg/branch_bottom') %>
      </div>
    </div>
  </section>

  <section id="characters-area" class=" mt-10">
    <div class="p-8 box w-full  xl:w-fit ">
      <div class="flex flex-row items-center mb-6">
        <h2>
          MAIN CHARACTERS
        </h2>
        <a href="https://docs.google.com/spreadsheets/d/1Cxz4chKcb1_rkF7xz_W2xEI7c2XZCl3L5kT-26hfEJY/edit?gid=2043747974#gid=2043747974" class="btn ms-auto">其餘角色請參照此表</a>
      </div>

      <div class="name-list columns-2 h-full text-left gap-8">
        <% ocEntries.forEach(function(entry) { const card = entry.card; %>
        <% if (entry.page) { %><button type="button" class="character-card oc-modal-trigger" aria-haspopup="dialog" aria-controls="<%= entry.dialogId %>"><% } else { %><div class="character-card"><% } %>
            <div class="avatar"><% if (card.avatar) { %><img src="<%= card.avatar %>" alt="" class="absolute"><% } %></div>
            <div>
              <p><%= card.name %></p>
              <% if (card.secondName) { %><p><%= card.secondName %></p><% } %>
            </div>
            <% if (entry.page) { %></button><% } else { %></div><% } %>
      <% }); %>
    </div>
    </div>
    <div class="p-8 box w-full h-fit xl:h-auto">
      <div class="flex flex-row items-center mb-6 ">
        <h2>
          TERMINOLOGY
        </h2>
      </div>
      <div id="terminology" class="noun-list">
        <table>
          <tbody>
            <tr class="border-dashed border border-gray-500 my-1">
              <td class="text-right whitespace-nowrap mr-1 p-2  border-dashed border-r border-gray-500">不敗女神</td>
              <td class="p-2">為鎮壓與平衡光影的流動而生於黑暗的神明，擁有壓倒且絕對的權能。自原初的兩神消失後視同眾神的領導者，然而實際上並不干涉其他神明的職權。</td>
            </tr>
            <tr class="border-dashed border border-gray-500 my-1">
              <td class="text-right whitespace-nowrap mr-1 p-2 border-dashed border-r border-gray-500">死神</td>
              <td class="p-2">神明中唯一直接接觸人類且造成直接性影響的支派，被其他神明低看的存在。</td>
            </tr>
            <tr class="border-dashed border border-gray-500 my-1">
              <td class="text-right whitespace-nowrap mr-1 p-2 border-dashed border-r border-gray-500">天上界</td>
              <td class="p-2">神明所在之處，沒有人能知道得知實際位置在哪裡，可能位於負維空間</td>
            </tr>
            <tr class="border-dashed border border-gray-500 my-1">
              <td class="text-right whitespace-nowrap mr-1 p-2 border-dashed border-r border-gray-500">世界之書</td>
              <td class="p-2">記載過去所有的歷史，包含平行世界的分支，本體為至高者之殿的河流，只能記錄已發生過的事，並沒有預測未來的功能。只有不敗女神有修改的權力。</td>
            </tr>
            <tr class="border-dashed border border-gray-500 my-1">
              <td class="text-right whitespace-nowrap mr-1 p-2 border-dashed border-r border-gray-500">至高者之殿</td>
              <td class="p-2">不敗女神於天上界的住所，大殿中央的泉水為流經所有世界河流的發源地。目前因女神轉生為人的緣故，殿內的王座是空著的。</td>
            </tr>
            <tr class="border-dashed border border-gray-500 my-1">
              <td class="text-right whitespace-nowrap mr-1 p-2 border-dashed border-r border-gray-500">十二守護者</td>
              <td class="p-2">表面上為女神直屬的護衛，實際上是掌握破滅神封印的十二把鑰匙。司掌屬性為：火焰、冰霜、疾風、雷電、森林、迷霧、大地、大海、天空、光明、黑暗、虛無</td>
            </tr>
            <tr class="border-dashed border border-gray-500 my-1">
              <td class="text-right whitespace-nowrap mr-1 p-2 border-dashed border-r border-gray-500">護界者</td>
              <td class="p-2">負責看守連接不同世界的職業，目前護界者的最上位負責人為海雯</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section id="creates-area" class=" mt-10">
    <div class="p-8 box">
      <h2 class="mb-4">
        ILLUSTRATION
      </h2>
      <div class="flex flex-row justify-center">
        <div id="gallery">
          <div class="gallery-sizer"></div>
        </div>
      </div>
    </div>
    <div class="p-8 box">
      <h2 class="mb-4">
        STORY
      </h2>
      <%- partial('_partial/post-category-pager', {
    id: 'story',
    category: ['Jatorri'],
    perPage: 5,
    listClass: 'px-6',
    prevText: '上一頁',
    nextText: '下一頁'
  }) %>
    </div>
  </section>
</section>

<%- partial('_partial/original-character-dialogs', { entries: ocEntries }) %>

<%- partial('_partial/cloudinary-gallery', {
  tag: 'jatorri',
  captions: {
    '': ''
  }
}) %>