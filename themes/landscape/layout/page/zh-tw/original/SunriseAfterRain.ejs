      </div>

      <div class="name-list columns-2 h-full text-left gap-8">

        <div class="character-card">
          <div class="avatar">
          </div>
          <div>
            <p>天雨甯</p>
          </div>
        </div>
        <div class="character-card">
          <div class="avatar">
          </div>
          <div>
            <p>文以朝</p>
          </div>
        </div>
        <div class="character-card">
          <div class="avatar">
          </div>
          <div>
            <p>言少罌</p>
          </div>
        </div>
        <div class="character-card">
          <div class="avatar">
          </div>
          <div>
            <p>封曄楠</p>
          </div>
        </div>
        <div class="character-card">
          <div class="avatar">
          </div>
          <div>
            <p>紀梓璇</p>
          </div>
        </div>
        <div class="character-card">
          <div class="avatar">
          </div>
          <div>
            <p>黎書琴</p>
