---
layout: page/layout
---

<div class="hero">
  <h1>Hello, I'm<br /><span>woufeder.</span></h1>
  <p>在這裡放一段自我介紹或口號，讓訪客知道你是做什麼的。</p>
  <div>
    <a href="#works" class="btn primary">查看作品</a>
    <a href="/BeforeDawn/zh-tw/blog/" class="btn">閱讀文章</a>
  </div>
</div>
<%
var currentLang = bd_current_lang();
var introPosts = [];

site.posts.each(function(post){
  if (bd_post_lang(post) !== currentLang) return;

  var matched = false;
  post.categories.each(function(cat){
    if (String(cat.name || '').trim() === '自介') {
      matched = true;
    }
  });

  if (matched) {
    introPosts.push(post);
  }
});

introPosts.sort(function(a, b){
  return b.date.valueOf() - a.date.valueOf();
});
%>

<section id="about-intro-posts">
  <% if (introPosts.length) { %>
    <% introPosts.forEach(function(post){ %>
      <%- partial('_partial/article', {post: post, index: true}) %>
    <% }) %>
  <% } else { %>
    <p>目前尚無「自介」分類文章。</p>
  <% } %>
</section>
