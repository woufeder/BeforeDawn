---
layout: false
---
<!DOCTYPE html>
<html lang="<%= page.lang || config.language || 'zh-TW' %>">

<head>
  <link rel="icon" href="<%= url_for('/favicon.ico') %>">
  <%- partial('_partial/google-analytics') %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= page.title %>
  </title>
  <%- partial('_partial/assets') %>
  <link rel="stylesheet" href="<%- url_for('assets/css/main.css') %>" />
  <style>
    html.is-changing .transition-fade {
      opacity: 1;
    }

    /* Define the styles for the unloaded pages */
    html.is-animating .transition-fade {
      opacity: 1;
    }
  </style>

</head>

<body>
  <div id="swup" class="transition-fade" style="
    --bg-image: url('<%= url_for(page.bg || '/image/bg-base.jpg') %>');
    --bg-color: <%= page.bgColor || 'rgba(35,36,61,0.9)' %>;
    --bg-blend: <%= page.bgBlend || 'multiply' %>;
    --text-color: <%= page.textColor || '#f0f0f0' %>;
    --text-color-hover: <%= page.textColorHover || '#f0f0f099' %>;
    --shadow-chinese: <%= page.shadowChinese || '0 0 6px rgba(255, 255, 255, 1)' %>;
    --shadow-latin: <%= page.shadowLatin || '0 0 5px rgba(255, 255, 255, 0.8), 0 0 5px rgba(255, 255, 255, 0.8)' %>;
  ">
    <main id="home" class="flex justify-center items-center">
      <section class="">
        <video class="home-video" autoplay muted loop playsinline preload="metadata">
          <source src="<%= url_for('video/light.mp4') %>" type="video/mp4">
        </video>
        <div class="home-content container fade-in-once">
          <div class="lang-switcher" aria-label="Language Switcher">
            <div class="lang-select">
              <svg class="lang-globe" viewBox="0 0 24 24" role="img" aria-label="globe">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" />
                <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path d="M3 12h18M5.5 7.5h13M5.5 16.5h13" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
              <select id="lang-select" class="lang-select-control" aria-label="Language" onchange="if(this.value){location.href=this.value;}">
                <option value="<%= url_for('/zh-tw/') %>" <%=page.lang==='zh-tw' ? 'selected' : '' %>>ZH</option>
                <option value="<%= url_for('/en/') %>" <%=page.lang==='en' ? 'selected' : '' %>>EN</option>
                <option value="<%= url_for('/it/') %>" <%=page.lang==='it' ? 'selected' : '' %>>IT</option>
              </select>
            </div>
          </div>
          <div class="flex flex-col md:flex-row  gap-8 md:gap-4 lg:gap-12 w-full">
            <div class="flex flex-col flex-2 xxl:flex-3">
              <div>
                <h1>夜明曉更前</h1>
                <h3>Anyway Before Dawn</h3>
              </div>
              <div class="intro mt-4 lg:mt-auto">
                <p>
                  This is a message for you—and just as much, one I leave for myself.<br>
                  Life is but a fleeting drift, crossing silent valleys, passing through desolation, wandering in circles, only to return to where it all began.<br><br>
                  Though I do not know why I have come to rest here, still cannot find the direction to depart. Yet I hope that, at least for a fleeting moment, within my story, you might glimpse something that feels strangely familiar.<br><br>
                  And before the break of dawn, may that feeling become a cradle—to hold the sorrow of both you and me.</p>
              </div>
            </div>
            <div class="border border-mist-100 border-dashed"></div>
            <div class="pageBtnBox flex-1 xxl:flex-2 flex flex-col justify-between
        items-start gap-6">
              <div>
                <p>Something in the distance seems to have caught your eye.
                  <br>
                  Where would you like to go next?</p>
              </div>
              <div class="BtnBox flex flex-col gap-4">
                <a href="<%= url_for('/' + page.lang + '/About/') %>" class="pageBtn">Boat Dweller ｜ <span><%= __('about') %>
                  </span> ➤</a>
                <a href="<%= url_for('/' + page.lang + '/Original/') %>" class="pageBtn">Beneath the Ocean ｜ <span><%= __('original') %>
                  </span> ➤</a>
                <a href="<%= url_for('/' + page.lang + '/Project/') %>" class="pageBtn">Traveler's Journal ｜<span>
                    <%= __('project') %>
                  </span> ➤</a>
                <a href="<%= url_for('/' + page.lang + '/Music/') %>" class="pageBtn">Humming from the Stars ｜ <span>
                    <%= __('music') %>
                  </span> ➤</a>
                <a href="<%= url_for('/' + page.lang + '/Others/') %>" class="pageBtn">Beyond the Light ｜ <span>
                    <%= __('others') %>
                  </span> ➤</a>
              </div>
              <div class="flex flex-row gap-4 sns">
                <a href="https://www.plurk.com/woufeder">Plurk</a>
                ｜
                <a href="">CXC</a>
                ｜
                <a href="">Facebook</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>


  <%- partial('_partial/after-footer') %>
  <script src="https://unpkg.com/swup@4"></script>
  <script src="https://unpkg.com/@swup/scripts-plugin@2"></script>
  <script src="<%= url_for('/js/swup-init.js') %>" defer></script>
</body>

</html>