<%
var defaultLang = Array.isArray(config.language) ? config.language[0] : config.language;
var currentLang = bd_current_lang();
function isVisible(post){
  return bd_post_lang(post) === currentLang;
}
var archives = {};
var visiblePosts = [];
site.posts.each(function(post){
  if (isVisible(post)) visiblePosts.push(post);
});
visiblePosts.forEach(function(post){
  var year = post.date.year();
  var month = post.date.month() + 1;
  var monthText = month < 10 ? '0' + month : '' + month;
  var key = year + '-' + monthText;
  if (!archives[key]) {
    archives[key] = { year: year, month: monthText, count: 0 };
  }
  archives[key].count += 1;
});
var archiveKeys = Object.keys(archives).sort().reverse();
%>
<% if (archiveKeys.length){ %>
  <div class="widget-wrap">
    <h6 class="widget-title"><%= bd_i18n('archives') %></h6>
    <div class="widget">
      <ul class="archive-list">
        <% archiveKeys.forEach(function(key){ %>
          <% var item = archives[key]; %>
          <li class="archive-list-item">
            <a class="archive-list-link" href="<%- bd_url_for_lang('/' + config.archive_dir + '/' + item.year + '/' + item.month + '/') %>"><%= key %></a>
            <span class="archive-list-count"><%= item.count %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>
