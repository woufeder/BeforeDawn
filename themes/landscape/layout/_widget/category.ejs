<%
var defaultLang = Array.isArray(config.language) ? config.language[0] : config.language;
var currentLang = bd_current_lang();
function isVisible(post){
  return bd_post_lang(post) === currentLang;
}
var visiblePosts = [];
if (page.posts && page.posts.each) {
  page.posts.each(function(post){ if (isVisible(post)) visiblePosts.push(post); });
} else {
  site.posts.each(function(post){
    if (isVisible(post)) visiblePosts.push(post);
  });
}
var categoryMap = {};
visiblePosts.forEach(function(post){
  if (!post.categories || !post.categories.each) return;
  post.categories.each(function(category){
    if (!categoryMap[category.name]) {
      categoryMap[category.name] = { name: category.name, path: category.path, count: 0 };
    }
    categoryMap[category.name].count += 1;
  });
});
var categoryRows = Object.keys(categoryMap).map(function(key){ return categoryMap[key]; }).sort(function(a, b){ return a.name.localeCompare(b.name); });
%>
<% if (categoryRows.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= bd_i18n('categories.All') %></h3>
    <div class="widget">
      <ul class="category-list">
        <li class="category-list-item">
          <a class="category-list-link" href="<%- bd_url_for_lang('/' + config.archive_dir + '/') %>"><%= bd_i18n('all_posts') %></a>
          <span class="category-list-count"><%= visiblePosts.length %></span>
        </li>
        <% categoryRows.forEach(function(category){ %>
          <li class="category-list-item">
            <a class="category-list-link" href="<%- bd_url_for_lang(category.path) %>"><%= category.name %></a>
            <span class="category-list-count"><%= category.count %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>
