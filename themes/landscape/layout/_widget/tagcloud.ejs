<%
var defaultLang = Array.isArray(config.language) ? config.language[0] : config.language;
var currentLang = bd_current_lang();
function isVisible(post){
  var postUrl = url_for(post.path) || '';
  if (currentLang === 'en') return postUrl.indexOf('/en/') !== -1;
  if (currentLang === 'zh-tw') return postUrl.indexOf('/en/') === -1;
  return true;
}
var visiblePosts = [];
if (page.posts && page.posts.each) {
  page.posts.each(function(post){ if (isVisible(post)) visiblePosts.push(post); });
} else {
  site.posts.each(function(post){
    if (isVisible(post)) visiblePosts.push(post);
  });
}
var tagMap = {};
visiblePosts.forEach(function(post){
  if (!post.tags || !post.tags.each) return;
  post.tags.each(function(tag){
    if (!tagMap[tag.name]) {
      tagMap[tag.name] = { name: tag.name, path: tag.path };
    }
  });
});
var tagRows = Object.keys(tagMap).map(function(key){ return tagMap[key]; }).sort(function(a, b){ return a.name.localeCompare(b.name); });
%>
<% if (tagRows.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('tagcloud') %></h3>
    <div class="widget tagcloud">
      <% tagRows.forEach(function(tag){ %>
        <a href="<%- url_for_lang(tag.path) %>" style="font-size: 12px;"><%= tag.name %></a>
      <% }) %>
    </div>
  </div>
<% } %>