// Config
support-for-ie = false
vendor-prefixes = webkit moz ms official

// Colors
$text-color = #f0f0f0
$text-sub-color = #bac1e6
$color-hover = #5a6286
color-grey = #999
color-border = #5a6286
color-link = #f0f0f0
color-background = #eee
color-sidebar-text = #222222
color-widget-border = #ccc
color-footer-background = #262a30
color-mobile-nav-background = #191919
color-twitter = #00aced
color-facebook = #3b5998
color-pinterest = #cb2027
color-linkedin = #000000
color-line = #06c755
color-instagram = #e1306c

// Fonts
font-sans = -apple-system, BlinkMacSystemFont,
    "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell",
    "Fira Sans", "Droid Sans", "Helvetica Neue",
    sans-serif
font-serif = Georgia, "Times New Roman", serif
font-mono = "Source Code Pro", Consolas, Monaco, Menlo, Consolas, monospace
font-icon = ForkAwesome
font-size = 17px
mobile-font-size = 14px
line-height = 1.5rem
line-height-title = 1.1em

// Header
logo-size = 40px
subtitle-size = 16px
banner-height = 300px
banner-url = hexo-config("banner")

sidebar = hexo-config("sidebar")

// Layout
block-margin = 1.5rem
article-padding = 2rem
mobile-nav-width = 280px
main-column = 9
sidebar-column = 3

if sidebar and sidebar isnt bottom
  _sidebar-column = sidebar-column
else
  _sidebar-column = 0

// Grids
column-width = 80px
gutter-width = 20px
columns = main-column + _sidebar-column
