$block-caption
  text-decoration: none
  text-transform: uppercase
  letter-spacing: 2px
  color: color-grey
  margin-bottom: 1em
  margin-left: 5px
  line-height: 1em
  text-shadow: 0 1px #fff
  font-weight: bold

$block
  background: #fff
  box-shadow: 1px 2px 3px #ddd
  border: 1px solid color-border
  border-radius: 3px

$base-style
/* ===== Typography ===== */

h1, h2, h3, h4, h5, h6 
  font-weight: inherit;

/* Headings */

h1 
  font-size: 2.5rem
  font-weight: 700
  line-height: 1.3

h2 
  font-size: 2rem
  font-weight: 600
  line-height: 1.35

h3 
  font-size: 1.5rem
  font-weight: 600
  line-height: 1.4

h4 
  font-size: 1.25rem
  font-weight: 500
  line-height: 1.45

h5 
  font-size: 1.125rem
  font-weight: 500
  line-height: 1.5

h6 
  font-size: 1rem
  font-weight: 500
  line-height: 1.5

/* Paragraph */

p 
  font-size: 1rem
  font-weight: 400
  line-height: 1.5

  hr
    border: 1px dashed color-border
  strong
    font-weight: bold
  em, cite
    font-style: italic
  sup, sub
    font-size: 0.75em
    line-height: 0
    position: relative
    vertical-align: baseline
  sup
    top: -0.5em
  sub
    bottom: -0.2em
  small
    font-size: 0.85em
  acronym, abbr
    border-bottom: 1px dotted
  ul, ol, dl
    margin: 0 20px
    line-height: line-height
  ul, ol
    ul, ol
      margin-top: 0
      margin-bottom: 0
  ul
    list-style: disc
  ol
    list-style: decimal
  dt
    font-weight: bold

  html,body
  font-family:
    'Iansui',
    'LXGW WenKai Mono TC',
    'Noto Sans TC',
    system-ui,
    sans-serif
