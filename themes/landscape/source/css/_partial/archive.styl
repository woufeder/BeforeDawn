.archives-wrap
  margin: block-margin 0

.archives
  clearfix()

.archive-year-wrap
  margin-bottom: 1em

.archive-year
  @extend $blog-side-title

.archives
  column-gap: 10px
  @media mq-tablet
    column-count: 2
  @media mq-normal
    column-count: 3

.archive-article
  avoid-column-break()

.archive-article-inner
  @extend $blog-box
  padding: 10px
  margin-bottom: 15px

.archive-article-title
  text-decoration: none
  font-weight: bold
  color: color-default
  transition: color 0.2s
  line-height: line-height
  &:hover
    color: color-link

.archive-article-footer
  margin-top: 1em

.archive-article-date
  color: color-grey
  text-decoration: none
  font-size: 0.85em
  line-height: 1em
  margin-bottom: 0.5em
  display: block

#page-nav
  margin: block-margin auto
  padding: 10px 14px
  display: flex
  align-items: center
  justify-content: center
  gap: 12px
  border-radius: 0
  border: none
  background: rgba(14,23,47,0.7)
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3)
  text-align: center
  color: rgba(236, 245, 255, 0.86)
  a, span
    min-width: 1.35rem
    padding: 0 0.2rem
    display: inline-flex
    align-items: center
    justify-content: center
    line-height: 1.2
    border-radius: 0
    border: none
    box-sizing: border-box
    font-size: 1.65rem
    letter-spacing: 0
    transition: color 0.2s ease, opacity 0.2s ease
  a
    color: #f2f7ff
    background: transparent
    text-decoration: none
    &:hover
      color: #ffffff
      opacity: 0.72
  .extend
    min-width: 1.7rem
    font-size: 1.8rem
    font-weight: 400
  .prev
    margin-right: 6px
  .next
    margin-left: 6px
  .first
    margin-right: 2px
  .last
    margin-left: 2px
  .page-number
    display: inline-block
    min-width: 1.9rem
    font-size: 1.05rem
    font-weight: 500
    letter-spacing: 0.03em
    font-family: "Iansui", serif
  .current
    color: #ffffff
    font-weight: 700
    background-color: rgb(40, 60, 116)
    border-radius: 4px
    padding: 0.2rem 0.4rem
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.8)
  .space
    background: transparent
    color: rgba(232, 237, 246, 0.5)
  .disabled
    opacity: 0.34
    color: rgba(232, 237, 246, 0.4)
    cursor: default

  @media mq-mobile
    gap: 8px
    padding: 8px 10px
    a, span
      min-width: 1.2rem
      height: 1.6rem
      font-size: 1.45rem
    .extend
      min-width: 1.45rem
    .page-number
      min-width: 1.65rem
      font-size: 0.95rem
