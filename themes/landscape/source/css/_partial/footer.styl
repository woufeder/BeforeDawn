#footer
  height: $footer-height
  box-shadow: 0 0 15px #ffffff6f
  padding: 1rem 0
  display: flex

.mt-1 
  margin-top: 0.25rem

.back-to-top
  position: fixed
  right: 50px
  bottom: 50px
  width: 44px
  height: 44px
  border: 1px solid rgba(255, 255, 255, 0.34)
  border-radius: 999px
  background: linear-gradient(180deg, rgba(19, 35, 67, 0.92), rgba(8, 19, 39, 0.94))
  color: #f1f6ff
  display: inline-flex
  align-items: center
  justify-content: center
  cursor: pointer
  opacity: 0.92
  transform: translateY(0)
  pointer-events: auto
  touch-action: manipulation
  transition: opacity 0.25s ease, transform 0.25s ease, border-color 0.2s ease, background 0.2s ease
  z-index: 9999
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35)
  .fa-solid
    font-size: 1.5rem

.back-to-top.is-hidden
  opacity: 0
  transform: translateY(10px)
  pointer-events: none

.back-to-top:hover
  border-color: rgba(160, 196, 255, 0.95)
  background: linear-gradient(180deg, rgba(49, 108, 239, 0.95), rgba(25, 76, 179, 0.95))

@media mq-mobile
  .back-to-top
    right: 12px
    bottom: 14px
    width: 40px
    height: 40px