$header-height = 95px
$footer-height = 80px
$all-02s-easeOut = all 0.2s ease-out
$text-color = #f0f0f0
$shadow-chinese = 0 0 6px rgba(255, 255, 255, 1)
$shadow-latin = 0 0 5px rgba(255, 255, 255, 0.8), 0 0 5px rgba(255, 255, 255, 0.8)
$menu-active-color = rgba(105, 120, 170, 0.5)

#header
  box-shadow: 0 0 15px #ffffff6f
  height $header-height

#logo
  display: flex
  align-items: center
  h2 
    font-weight: normal
    font-family:"Iansui", "LXGW WenKai Mono TC", "Noto Sans TC", system-ui, sans-serif
    text-shadow: $shadow-chinese
  h4
    font-family: "Fredericka the Great"
    text-shadow: $shadow-latin
    text-wrap: nowrap
  
#main-nav
  float: left
  margin-left: -15px
  position: relative
  font-family: "Fredericka the Great"

.main-nav-item
  float: left
  position: relative

.main-nav-item .main-nav-link
  float: none

.nav-icon,
.main-nav-link 
  float: left
  opacity: 1
  text-decoration: none
  text-shadow: $shadow-latin
  transition: $all-02s-easeOut
  display: block
  padding: 0px 10px
  &:hover 
    background-color: $menu-active-color
    background-blend-mode: multiply
  
.nav-icon 
  text-align: center
  color: $text-color
  font-size: 16px
  width: 16px
  height: 16px
  padding: 20px 15px
  position: relative
  cursor: pointer

.main-nav-link 
  font-weight: 300
  letter-spacing: 1px
  border-right: #686868 0.5px solid
  width: 105px
  text-wrap: nowrap
  text-align: end
  transition: $all-02s-easeOut
  &:last-child 
    border-right: none
  

.main-nav-submenu
  display: none
  position: absolute
  top: 100%
  left: 0
  min-width: 140px
  background:
    linear-gradient($menu-active-color, $menu-active-color),
    #000000ee
  border: #686868 0.5px solid
  z-index: 99
  font-weight: 300
  font-family: "Fredericka the Great", "Iansui"

.main-nav-item.has-submenu:hover .main-nav-submenu
  display: block

.main-nav-submenu-link
  display: block
  opacity: 1
  text-decoration: none
  padding: 10px 14px
  white-space: nowrap
  transition: $all-02s-easeOut
  text-shadow: $shadow-chinese
  &:hover
    opacity: 0.5

.main-nav-submenu-link.is-active 
  background-color: $menu-active-color
  background-blend-mode: multiply
  &:hover 
    opacity: 0.5
    background: rgba(255, 255, 255, 0.12)
  

.nav-note 
  width: 105px
  text-shadow: $shadow-chinese

.lang-switch 
  padding-right: 10px
  padding-top: 10px
  cursor: pointer
  &:hover 
    transition: var(--all-02s-easeOut) !important
    color: var(--text-color-hover) !important

.lang-globe 
  width: 20px
  height: 20px
  pointer-events: none


.main-nav-link
  @media mq-mobile
    display: none

.mobile-nav-sub-link
  padding-left: 30px
  opacity: 0.85

#main-nav-toggle
  display: none
  @media mq-mobile
    display: block

#sub-nav
  float: right
  margin-right: -15px